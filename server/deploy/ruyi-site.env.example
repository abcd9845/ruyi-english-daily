# /etc/ruyi-site/ruyi-site.env   (root:root, mode 600; directory /etc/ruyi-site mode 750)
# Placeholders only. Fill the <...> values on the server; never commit or paste real values.
# systemd reads this file as root; do not put secrets on the command line.

# --- required ---
RUYI_STATIC_DIR=/opt/ruyi-english-daily
RUYI_FAMILY_CODE=<family code chosen by the parent, min 6 chars>
RUYI_SESSION_SECRET=<output of: openssl rand -hex 32>
RUYI_BRAIN_BASE_URL=<brain base URL, scheme://host:port, no trailing path>
RUYI_BRAIN_TOKEN=<bank:read token issued for the practice site>

# --- optional (defaults shown) ---
RUYI_LISTEN=:18082
RUYI_SESSION_TTL=720h
# 0 while the site is served over plain http; set 1 after HTTPS is in place
RUYI_COOKIE_SECURE=0
RUYI_LOG_LEVEL=info
# ntfy topic used by the dynamic page's submit button (delivered to the browser after login).
# Leave unset to show "提交通道未配置". Use a NEW topic (the old one is public in the old pages).
#RUYI_NTFY_TOPIC=<ntfy topic>
# Only these source keys can be requested through /api/sets and /api/media (comma separated).
#RUYI_ALLOWED_SOURCES=math-intake.zz-yuekao-numberline-4y

# --- brain TLS: pick AT MOST ONE (default = strict verification) ---
# 1) brain on this host with a self-signed certificate (loopback address only; refused otherwise):
#RUYI_BRAIN_INSECURE_TLS=1
# 2) or trust a specific CA/certificate (file must be readable by user ruyi-site, e.g. under /opt/ruyi-site/):
#RUYI_BRAIN_CA_FILE=/opt/ruyi-site/brain-ca.pem
