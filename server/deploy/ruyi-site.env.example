# /etc/ruyi-site/ruyi-site.env   (root:root, mode 600; directory /etc/ruyi-site mode 750)
# Placeholders only. Fill the <...> values on the server; never commit or paste real values.
# systemd reads this file as root; do not put secrets on the command line.

# --- required ---
RUYI_STATIC_DIR=/opt/ruyi-english-daily
RUYI_FAMILY_CODE=<family code chosen by the parent, min 5 chars; short code -> rely on the login rate limit, consider a longer one later>
RUYI_SESSION_SECRET=<output of: openssl rand -hex 32>
RUYI_BRAIN_BASE_URL=<brain base URL, scheme://host:port, no trailing path>
RUYI_BRAIN_TOKEN=<bank:read token issued for the practice site>

# --- optional (defaults shown) ---
RUYI_LISTEN=:18082
RUYI_SESSION_TTL=720h
# 0 while the site is served over plain http; set 1 after HTTPS is in place
RUYI_COOKIE_SECURE=0
RUYI_LOG_LEVEL=info
# ntfy topic used by the dynamic page's submit button (delivered to the browser after login).
# Leave unset to show "提交通道未配置". Use a NEW topic (the old one is public in the old pages).
#RUYI_NTFY_TOPIC=<ntfy topic>
# Only these source keys can be requested through /api/sets and /api/media (comma separated).
#RUYI_ALLOWED_SOURCES=math-intake.zz-yuekao-numberline-4y

# --- brain TLS: pick AT MOST ONE (default = strict verification) ---
# 1) brain on this host with a self-signed certificate (loopback address only; refused otherwise):
#RUYI_BRAIN_INSECURE_TLS=1
# 2) or trust a specific CA/certificate (file must be readable by user ruyi-site, e.g. under /opt/ruyi-site/):
#RUYI_BRAIN_CA_FILE=/opt/ruyi-site/brain-ca.pem

# --- practice sets, grading, archive, auto sets (see DEPLOY-P3.md) ---
#RUYI_SETS_FILE=/etc/ruyi-site/sets.json
# Practice-site token, used for POST /v1/bank/grade AND GET /v1/brain/pick-practice (the brain wants the target
# brain's write scope for both; the bank:read token gets 403 there); server-side only. Without it there is no grading
# and no brain-side picking (due_first / wrong_only answer 501 "not ready"; the read token is never used instead).
# Lookup / lists / media keep using RUYI_BRAIN_TOKEN. It MUST differ from RUYI_BRAIN_TOKEN
# (startup refuses equal values). The brain decides its scope (bank:read + write to the single brain "ruyi";
# a narrower bank:grade may come later) - nothing here depends on the scope name.
# Empty = no grading: submissions are archived + notified only, the page says 已提交（暂未判分）.
# The grade/lookup/pick-practice endpoints exist only after the brain's #35 is deployed; until then the site degrades gracefully.
#RUYI_BRAIN_GRADE_TOKEN=<practice-site token>
# Optional. The brain id sent to grade (body) and pick-practice (query); default ruyi. For integration testing against a
# test brain, e.g. qa-practice. Both tokens' scopes must match it. Format: ^[a-z0-9][a-z0-9_-]{0,63}$
#RUYI_BRAIN_ID=ruyi
# Endpoint paths of the brain contract (defaults shown); change only if the brain moves them.
#RUYI_BRAIN_GRADE_PATH=/v1/bank/grade
#RUYI_BRAIN_LOOKUP_PATH=/v1/bank/questions/lookup
#RUYI_BRAIN_PICK_PATH=/v1/brain/pick-practice
# 1 = drop brain picks marked deferred:* (pending key / unsupported type / missing figure); default 0 keeps and labels them.
#RUYI_PICK_SKIP_DEFERRED=0
# Must exist, 0700 and owned by ruyi-site, and be listed in the unit's ReadWritePaths (systemd 219: no StateDirectory=).
#RUYI_ATTEMPTS_DIR=/var/lib/ruyi-site/attempts
#RUYI_GRADE_MAX_PER_HOUR=5
# Sources that /api/practice/new may draw from (empty = feature off).
#RUYI_AUTO_SOURCES=<source key>
#RUYI_AUTO_TTL=6h

# --- S1 pending-answer queue (see DEPLOY-S1 in DEPLOY-P3.md §9). ALL OFF by default: nothing below changes anything until RUYI_QUEUE_ENABLED=1 ---
# 1 = answers the brain cannot grade (pending_key / needs_review / unsupported) are also queued for the brain's AI; the page shows the
# per-answer status ("待解答 -> AI 判卷中 -> AI初评·待家长核"). Needs RUYI_BRAIN_GRADE_TOKEN (the write token queues the answers).
#RUYI_QUEUE_ENABLED=0
# 1 = start the poller that tells the parent (ntfy) once per set when the AI first pass is ready. Needs RUYI_QUEUE_ENABLED=1,
# RUYI_BRAIN_NOTIFY_TOKEN and RUYI_NTFY_TOPIC.
#RUYI_QUEUE_NOTIFY_ENABLED=0
# THIRD token (events + ack only). Must differ from RUYI_BRAIN_TOKEN and RUYI_BRAIN_GRADE_TOKEN (startup refuses equal values). Never
# used for anything else and the write token is never used instead (a 403 only logs a warning).
#RUYI_BRAIN_NOTIFY_TOKEN=<notify token>
# Poller period in seconds, 40..600, default 45 (the poller adds +-10% jitter).
#RUYI_QUEUE_POLL_SECONDS=45
# Local queue state (links.jsonl, notify.json, sent.jsonl, .lock). Absolute path; must exist, 0700, owned by ruyi-site, writable
# in the unit (ReadWritePaths). Startup refuses to run with the queue on if it is not usable.
#RUYI_QUEUE_STATE_DIR=/var/lib/ruyi-site/queue
# Path of the brain's enqueue endpoint (default shown); change only if the brain moves it.
#RUYI_BRAIN_PENDING_PATH=/v1/bank/pending-answers
